{
  "manifest_version": 2,
  "name": "Omnibar Shortcuts",
  "version": "1.0",
  "description": "Create custom keywords to instantly go to a set website using omnibar search",
  "permissions": ["storage", "webNavigation", "tabs", "<all_urls>"],
  "background": {
    "scripts": ["dist/background.js"]
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "davidmxu26@gmail.com" 
    }
  }
}